# =============================================================================
# Caddyfile.with-metabase — reverse proxy, TLS, and the dashboard subdomain
# =============================================================================
# Purpose:
#   Identical to `infra/Caddyfile` (the app's own site block, unchanged) plus
#   a second site block routing the BI dashboard subdomain to Metabase.
#   Sslip.io resolves any subdomain of a `<dashes>.sslip.io` name to the same
#   IP, so `dashboard.` needs no DNS record of its own; Caddy issues that
#   block its own certificate automatically, the same way it does for the
#   bare host name.
# Design:
#   A separate file, not a runtime edit of `infra/Caddyfile`: `infra/scripts/
#   08-deploy-metabase.sh` swaps this in and reloads Caddy only after
#   Metabase's first-run setup succeeds (ADR-11: the reverse proxy must not
#   reach Metabase before then) — until that swap, this file is never
#   deployed, so Metabase is unreachable through Caddy by construction, not
#   by a request-time check. A subdomain, not a path prefix, because
#   Metabase does not support being served under a non-root path without
#   extra configuration this project does not otherwise need.
# Usage:
#   Deployed in place of `infra/Caddyfile` by `infra/scripts/
#   08-deploy-metabase.sh`; not run directly from this repository.
# =============================================================================

{$HOST_NAME} {
	# The backend's own routes: /api/*, its health endpoints and the session/auth routes
	# (app/main.py and app/api/auth.py register /health/live, /health/ready, /v1/session and
	# /v1/auth/* at the root, not under /api) all route here.
	@backend path /api/* /health/* /v1/*
	handle @backend {
		reverse_proxy backend:8000
	}

	# The web build's static files, served by the web container.
	handle {
		reverse_proxy web:80
	}
}

dashboard.{$HOST_NAME} {
	reverse_proxy metabase:3000
}
