# =============================================================================
# .env.example — configuration template (copy to .env; never commit real values)
# =============================================================================
# Every variable read by app/config.py is listed here with its default.
# `make setup` copies this file to .env when .env does not exist.
# Secrets belong only in the real .env (git-ignored) or a secret manager.
# =============================================================================

# Runtime environment: local | dev | prod                          (optional, default local)
APP_ENV=local

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL              (optional, default INFO)
LOG_LEVEL=INFO

# Build identifier reported by /health/ready (git SHA in deployed images) (optional)
SERVICE_VERSION=dev

# LLM provider behind the provider interface: anthropic | bedrock | stub. stub makes no model
# call and needs no API key; it is refused when APP_ENV=prod.  (optional, default anthropic)
LLM_PROVIDER=anthropic

# Pinned model ids; must be members of the allow-list in app/config.py, which holds exactly
# claude-haiku-4-5-20251001 (understanding) and claude-sonnet-5 (rendering)  (optional)
NLU_MODEL=claude-haiku-4-5-20251001
RENDER_MODEL=claude-sonnet-5

# Anthropic API key — required for any feature that calls the LLM when LLM_PROVIDER=anthropic.
# May stay empty otherwise; the app starts without it and fails only when an LLM call needs it.
ANTHROPIC_API_KEY=

# Key that signs session tokens; at least 32 characters (for example: openssl rand -hex 32).
# Optional when APP_ENV=local (the service then uses a throw-away key that changes on every
# start); required when APP_ENV is dev or prod.
SESSION_SIGNING_KEY=

# Lifetime of a session token in seconds, 60 to 3600                (optional, default 900)
SESSION_TTL_SECONDS=900

# Sandbox login: lets a test client obtain a session for a chosen customer. Never enable in prod.
# When true, TEST_IDENTITY_KEY (at least 16 characters) is required and is sent by the client in
# the X-Test-Login-Key header.                                        (optional, default false)
TEST_IDENTITY_ENABLED=false
TEST_IDENTITY_KEY=

# DSN of the serving store, for example
# postgresql://dispute_intake:dispute_intake@localhost:5432/dispute_intake against the local
# docker-compose service. Optional until a feature that reads or writes it runs; make migrate
# requires it.
DATABASE_URL=

# Free-form model rendering. When true, an eligible reply is drafted by the model and used only
# if the output verifier grounds it against the envelope's own facts; any other outcome sends the
# template reply. Requires LLM_PROVIDER=anthropic. Defaults to false.
MODEL_RENDERER_ENABLED=false

# Domain date override: an ISO date (for example 2026-06-18), or the literal word
# "system" for the real date in the bank's own zone (America/Bogota). Optional; when empty, the
# service reads the loaded seed's own reference date (ops_meta.data_as_of) instead, and refuses
# to start if neither resolves.
DATA_AS_OF_DATE=

# Per-session cap on cases the create tool will file, 1 to 50. A permission-class invariant,
# not a policy value: an anti-abuse bound on one session's filing attempts, never a limit on how
# many distinct disputes a customer legitimately has.  (optional, default 3)
CASE_CREATE_SESSION_CAP=3

# Most customer turns one session may apply, 5 to 200. Once reached, the next message is answered
# with the standard handoff to a person and no model call, which bounds the model calls one session
# can cause. A cost control, not a policy value; the longest normal flow is about six messages.
# (optional, default 30)
DIALOGUE_MAX_TURNS=30

# Bounded retry and circuit breaker for the LLM port and the tool port: full-jitter
# exponential backoff between attempts, capped at the max delay; the breaker opens after the
# given number of consecutive post-retry failures and allows one trial call again after the
# reset window. (all optional, defaults shown)
LLM_RETRY_MAX_ATTEMPTS=2
LLM_RETRY_BASE_DELAY_MS=200
LLM_RETRY_MAX_DELAY_MS=2000
TOOL_RETRY_MAX_ATTEMPTS=3
TOOL_RETRY_BASE_DELAY_MS=50
TOOL_RETRY_MAX_DELAY_MS=400
LLM_BREAKER_FAILURE_THRESHOLD=5
LLM_BREAKER_RESET_SECONDS=30
TOOL_BREAKER_FAILURE_THRESHOLD=5
TOOL_BREAKER_RESET_SECONDS=10

# Daily spend limit on language-model calls, in US dollars, counted per bank operating day
# (America/Bogota). Once the day's recorded spend reaches it, understanding hands the customer to a
# person and the optional model renderer falls back to the template reply until the next day.
# (optional, default 10)
LLM_DAILY_SPEND_LIMIT_USD=10

# Promised contact time after a handoff, in calendar days from the data reference date: the
# priority value applies to a fraud report or a lost or stolen card, the default value to every
# other trigger. A separate, synthetic configuration value with its own provenance, distinct from
# the policy's own filing-response time. (optional, defaults 1 and 2)
POST_HANDOFF_CONTACT_DAYS_PRIORITY=1
POST_HANDOFF_CONTACT_DAYS_DEFAULT=2

# Demonstration sign-in broker: a public, persona-based sign-in for the deployed
# demonstration, distinct from the sandbox login above and mutually exclusive with it — unlike the
# sandbox login, it is meant to run in prod. When true, DEMO_SIGNIN_ACCESS_CODE (at least 16
# characters) is required. In the deployment this value is provisioned from SSM, never committed.
#                                                                     (optional, default false)
DEMO_SIGNIN_ENABLED=false
DEMO_SIGNIN_ACCESS_CODE=

# Agent demonstration sign-in broker: the console's own sign-in, with its own
# access code so a leaked customer code never exposes it. Also mutually exclusive with the
# sandbox login. When true, DEMO_AGENT_ACCESS_CODE (at least 16 characters) and
# AGENT_SESSION_SIGNING_KEY (at least 32 characters, at least 8 distinct) are both required. In
# the deployment both values are provisioned from SSM, never committed.
#                                                                     (optional, default false)
DEMO_AGENT_SIGNIN_ENABLED=false
DEMO_AGENT_ACCESS_CODE=
AGENT_SESSION_SIGNING_KEY=
