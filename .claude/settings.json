{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(gh pr review *)",
      "Bash(gh pr ready *)",
      "Bash(gh auth *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git config user.name *)",
      "Bash(git config user.email *)",
      "Read(./.env)",
      "Read(./**/.env)",
      "Edit(./.claude/identity.json)",
      "Edit(./.claude/settings.json)",
      "Edit(./.githooks/**)",
      "Edit(./.github/workflows/review-gate.yml)",
      "Edit(./.github/CODEOWNERS)"
    ]
  }
}
