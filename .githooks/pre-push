#!/usr/bin/env sh
# Block direct pushes to protected branches. Changes reach main only through PRs.
set -eu
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      echo "Direct pushes to ${remote_ref#refs/heads/} are not allowed. Open a pull request." >&2
      exit 1
      ;;
  esac
done
exit 0
